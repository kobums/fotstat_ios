require "fileutils"
require "shellwords"

default_platform(:ios)

XCODEPROJ = "fotstat.xcodeproj"
# 레인 전환 시 fastlane이 디렉터리를 바꾸므로 상대경로는 깨진다 → Fastfile 기준 절대경로 사용
PBXPROJ   = File.expand_path("../#{XCODEPROJ}/project.pbxproj", __dir__)
SCHEME    = "fotstat"
APP_ID    = "com.gowoobro.fotstat"
INFOPLIST = "fotstat/Info.plist"
# App Store 릴리즈노트를 기록할 로케일 (앱의 기본 언어에 맞춤)
RELEASE_LOCALE = ENV["ASC_LOCALE"] || "ko"

# 인증/자격증명 오류는 "첫 업로드(빌드 없음)"와 달리 치명적이므로 재발생시킨다.
def auth_error?(message)
  message.to_s.match?(/Authentication credentials|invalid.*token|unauthorized|NOT_AUTHORIZED/i)
end

platform :ios do
  # ---------------------------------------------------------------------------
  # 공개 레인
  # ---------------------------------------------------------------------------

  desc "TestFlight 배포: 빌드번호 +1 → 아카이브 → 업로드(체인지로그 자동)"
  lane :beta do
    key   = load_api_key
    bump_build(api_key: key)
    notes = git_changelog
    archive
    upload_to_testflight(
      api_key: key,
      changelog: notes,
      distribute_external: false,
      skip_waiting_for_build_processing: false
    )
    finalize_git(release: false)
    UI.success("✅ TestFlight 업로드 완료")
  end

  desc "App Store 심사 제출: 마케팅버전 자동증가 → 빌드번호 +1 → 릴리즈노트 기록 → 아카이브 → 업로드(처리 대기) → 심사 제출"
  lane :release do
    key   = load_api_key
    # 현재 마케팅 버전이 App Store에서 이미 닫혀(출시/심사완료) 새 빌드를 못 받으면 patch 자동 증가
    ensure_release_version
    bump_build(api_key: key, include_app_store: true)
    notes = git_changelog
    write_release_notes(notes: notes)
    archive

    # 1) 바이너리 업로드 + App Store Connect 처리(Processing) 완료까지 대기.
    #    처리 전에는 빌드를 버전에 연결할 수 없어 심사 제출이 실패하므로 반드시 대기한다.
    #    외부 배포·테스터 알림 없이 업로드만 수행. TestFlight "테스트할 내용"에 체인지로그 기록.
    upload_to_testflight(
      api_key: key,
      changelog: notes,
      distribute_external: false,
      skip_submission: true,
      skip_waiting_for_build_processing: false
    )

    # 2) 처리된 빌드에 릴리즈노트(metadata)를 붙여 심사 제출. 바이너리는 재업로드하지 않음.
    upload_to_app_store(
      api_key: key,
      skip_binary_upload: true,          # 1)에서 이미 업로드·처리됨
      submit_for_review: true,
      reject_if_possible: true,          # 심사 대기/거부 상태면 취소하고 새 빌드로 재제출
      automatic_release: true,           # 승인되면 자동 출시
      force: true,                       # HTML 미리보기 확인 생략
      skip_screenshots: true,
      skip_metadata: false,              # release_notes.txt 만 갱신
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      submission_information: {
        export_compliance_uses_encryption: false,
        add_id_info_uses_idfa: false
      }
    )
    finalize_git(release: true)
    UI.success("✅ App Store 심사 제출 완료")
  end

  desc "마케팅 버전 올리기 (사용법: fastlane bump_version type:patch|minor|major)"
  lane :bump_version do |options|
    type = options[:type] || "patch"
    current = get_version_number(xcodeproj: XCODEPROJ, target: SCHEME)
    major, minor, patch = "#{current}.0.0".split(".").map(&:to_i)
    case type
    when "major" then major += 1; minor = 0; patch = 0
    when "minor" then minor += 1; patch = 0
    else patch += 1
    end
    new_v = "#{major}.#{minor}.#{patch}"
    set_marketing_version(version: new_v)
    UI.success("마케팅 버전 #{current} → #{new_v}")
  end

  desc "App Store 버전/상태 조회 (fastlane status)"
  lane :status do
    # app_store_connect_api_key(set_spaceship_token 기본 true)가 Spaceship 전역 토큰을
    # 설정하므로, 이후 Spaceship 직접 호출이 대화형 로그인 없이 동작한다.
    load_api_key
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    UI.message("App: #{app.name} (#{app.id})")
    UI.header("App Store Versions")
    app.get_app_store_versions(includes: "build").each do |v|
      b = (v.build rescue nil)
      UI.message("v#{v.version_string}  state=#{v.app_store_state}  build=#{b&.version}  versionId=#{v.id}")
    end
  end

  # ---------------------------------------------------------------------------
  # 내부 헬퍼 레인
  # ---------------------------------------------------------------------------

  desc "앱 아카이브 + IPA 추출 (App Store 배포용)"
  private_lane :archive do
    build_app(
      scheme: SCHEME,
      project: XCODEPROJ,
      export_method: "app-store",
      output_directory: "build",
      clean: true
    )
  end

  desc "App Store Connect API 키 로드 (.env 의 ASC_* 사용)"
  private_lane :load_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_FILEPATH"),
      duration: 1200,
      in_house: false
    )
  end

  desc "MARKETING_VERSION 빌드 세팅을 직접 수정 (agvtool은 Info.plist 변수 참조를 손상시킴)"
  private_lane :set_marketing_version do |options|
    new_v = options[:version]
    content = File.read(PBXPROJ)
    # gsub!은 매칭 실패 시 nil 반환 → 조용히 버전 미변경되는 것을 방지
    UI.user_error!("pbxproj 에서 MARKETING_VERSION 키를 찾지 못했습니다: #{PBXPROJ}") if content.gsub!(/MARKETING_VERSION = [^;]+;/, "MARKETING_VERSION = #{new_v};").nil?
    File.write(PBXPROJ, content)
    new_v
  end

  desc "현재 마케팅 버전이 App Store에서 닫혀 있으면(새 빌드 제출 불가) patch 를 자동 증가"
  private_lane :ensure_release_version do
    current = get_version_number(xcodeproj: XCODEPROJ, target: SCHEME)

    # 새 빌드를 받을 수 있는(편집 가능한) App Store 버전 상태.
    # 이 외(READY_FOR_SALE 등 출시 완료 / PENDING_APPLE_RELEASE 등 Apple 출시 대기)는
    # "닫힌" 버전으로 보고 새 버전이 필요하다.
    # WAITING_FOR_REVIEW/READY_FOR_REVIEW/IN_REVIEW 는 release 레인의 reject_if_possible 로
    # 취소 후 같은 버전에 재제출 가능하므로 편집 가능으로 본다.
    editable = %w[
      PREPARE_FOR_SUBMISSION DEVELOPER_REJECTED REJECTED METADATA_REJECTED
      INVALID_BINARY WAITING_FOR_REVIEW READY_FOR_REVIEW IN_REVIEW
      WAITING_FOR_EXPORT_COMPLIANCE PENDING_DEVELOPER_RELEASE
      PENDING_CONTRACT PROCESSING_FOR_APP_STORE
    ]

    versions =
      begin
        # iOS 전용 — 다른 플랫폼의 동일 버전 문자열이 섞이지 않도록 플랫폼 고정
        Spaceship::ConnectAPI::App.find(APP_ID).get_app_store_versions(
          filter: { platform: "IOS" }
        )
      rescue => e
        UI.user_error!("App Store Connect 인증 실패 — .env 의 ASC_KEY_ID/ASC_ISSUER_ID/.p8 를 확인하세요.\n#{e.message}") if auth_error?(e.message)
        UI.important("App Store 버전 조회 실패 — 버전 자동증가를 건너뜁니다: #{e.message}")
        next
      end

    current_records = versions.select { |v| v.version_string == current }
    if current_records.empty?
      UI.message("버전 #{current} 은 App Store Connect 에 없으므로 그대로 새 버전으로 제출합니다.")
      next
    end
    if current_records.any? { |v| editable.include?(v.app_store_state) }
      UI.message("버전 #{current} 은 편집 가능한 상태입니다. 그대로 제출합니다.")
      next
    end

    # current 가 닫혀 있음 → 닫히지 않은 다음 patch 버전을 찾는다.
    closed = versions.reject { |v| editable.include?(v.app_store_state) }.map(&:version_string)
    major, minor, patch = current.split(".").map(&:to_i)
    # 연속된 patch 가 모두 닫혀 있어도 무한루프에 빠지지 않도록 상한을 둔다.
    max_patch = patch + 50
    loop do
      patch += 1
      UI.user_error!("사용 가능한 patch 버전을 찾지 못했습니다 (#{major}.#{minor}.x 가 모두 닫힘). bump_version 으로 minor/major 를 올리세요.") if patch > max_patch
      new_v = "#{major}.#{minor}.#{patch}"
      next if closed.include?(new_v)
      set_marketing_version(version: new_v)
      UI.success("마케팅 버전 #{current} → #{new_v} (#{current} 이 닫혀 있어 자동 증가)")
      break
    end
  end

  desc "빌드번호를 (TestFlight·App Store 최신) +1 로 설정"
  private_lane :bump_build do |options|
    version = get_version_number(xcodeproj: XCODEPROJ, target: SCHEME)
    candidates = [0]

    candidates << begin
      latest_testflight_build_number(
        api_key: options[:api_key],
        version: version,
        app_identifier: APP_ID
      ).to_i
    rescue => e
      UI.user_error!("App Store Connect 인증 실패 — .env 의 ASC_KEY_ID/ASC_ISSUER_ID/.p8 를 확인하세요.\n#{e.message}") if auth_error?(e.message)
      UI.important("TestFlight 빌드번호 조회 실패(첫 업로드일 수 있음): #{e.message}")
      0
    end

    if options[:include_app_store]
      candidates << begin
        app_store_build_number(
          api_key: options[:api_key],
          live: false,
          version: version,
          app_identifier: APP_ID
        ).to_i
      rescue => e
        UI.user_error!("App Store Connect 인증 실패 — .env 의 ASC_KEY_ID/ASC_ISSUER_ID/.p8 를 확인하세요.\n#{e.message}") if auth_error?(e.message)
        UI.important("App Store 빌드번호 조회 실패: #{e.message}")
        0
      end
    end

    next_build = candidates.max + 1
    # agvtool(increment_build_number)은 Info.plist의 $(...) 변수 참조를 리터럴로
    # 덮어써 손상시키므로, Info.plist에 직접 빌드번호를 기록한다.
    set_info_plist_value(path: INFOPLIST, key: "CFBundleVersion", value: next_build.to_s)
    UI.message("버전 #{version} / 빌드번호 → #{next_build}")
  end

  desc "마지막 태그 이후 커밋으로 체인지로그 생성"
  private_lane :git_changelog do
    last_tag = (last_git_tag rescue nil)
    notes =
      if last_tag
        changelog_from_git_commits(
          between: [last_tag, "HEAD"],
          pretty: "- %s",
          merge_commit_filtering: "exclude_merges"
        )
      else
        changelog_from_git_commits(
          commits_count: 30,
          pretty: "- %s",
          merge_commit_filtering: "exclude_merges"
        )
      end
    notes = "- 안정성 개선 및 버그 수정" if notes.nil? || notes.strip.empty?
    UI.message("체인지로그:\n#{notes}")
    notes
  end

  desc "App Store 릴리즈노트 파일에 기록"
  private_lane :write_release_notes do |options|
    notes = options[:notes]
    path = File.join(__dir__, "metadata", RELEASE_LOCALE, "release_notes.txt")
    FileUtils.mkdir_p(File.dirname(path))
    File.write(path, notes)
    UI.message("릴리즈노트 기록: #{path}")
  end

  desc "버전 커밋 + 태그 (PUSH_AFTER_DEPLOY=1 이면 원격 푸시)"
  private_lane :finalize_git do |options|
    version = get_version_number(xcodeproj: XCODEPROJ, target: SCHEME)
    build   = get_info_plist_value(path: INFOPLIST, key: "CFBundleVersion")
    paths = [INFOPLIST]
    paths << "fastlane/metadata/#{RELEASE_LOCALE}/release_notes.txt" if options[:release]
    # bump_version/ensure_release_version으로 MARKETING_VERSION이 바뀐 경우 pbxproj도 함께 커밋한다.
    # (변경이 없을 때 paths에 넣으면 git_commit이 실패하므로 dirty일 때만 추가)
    # 레인 전환으로 CWD가 바뀌어도 안전하도록 절대경로(PBXPROJ)로 status를 확인한다.
    paths << PBXPROJ unless sh("git status --porcelain #{PBXPROJ.shellescape}", log: false).strip.empty?
    # 새로 생성된(untracked) 파일은 git commit <path>로 못 잡으므로 먼저 스테이징한다.
    git_add(path: paths)
    git_commit(path: paths, message: "chore(release): #{version} (#{build})")
    add_git_tag(tag: "v#{version}-#{build}")
    if ENV["PUSH_AFTER_DEPLOY"] == "1"
      push_to_git_remote(tags: true)
      UI.message("원격 푸시 완료")
    else
      UI.message("로컬 커밋/태그만 생성 (원격 푸시하려면 PUSH_AFTER_DEPLOY=1)")
    end
  end

  error do |lane, exception|
    UI.error("❌ #{lane} 실패: #{exception.message}")
  end
end
