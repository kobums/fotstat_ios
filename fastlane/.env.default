# fastlane 환경변수 템플릿.
# 실제 값은 이 파일을 복사해 fastlane/.env 로 만들어 채운다 (.env 는 git 무시됨).
#   cp fastlane/.env.default fastlane/.env

# ===== App Store Connect API 키 =====
# App Store Connect → 사용자 및 액세스 → 통합(Integrations) → 팀 키 에서 발급
ASC_KEY_ID=
ASC_ISSUER_ID=
# 발급받은 AuthKey_XXXXXX.p8 파일 경로 (저장소 밖 또는 git 무시 경로 권장)
ASC_KEY_FILEPATH=./fastlane/AuthKey.p8
# Apple Developer 팀 ID (미설정 시 Appfile 기본값 사용)
ASC_TEAM_ID=

# ===== 선택 =====
# App Store 릴리즈노트 로케일 (기본 ko)
ASC_LOCALE=ko
# 배포 후 버전 커밋/태그를 원격에 푸시하려면 1
PUSH_AFTER_DEPLOY=0
# Apple ID 로그인을 병행할 때만 (API 키 사용 시 불필요)
FASTLANE_APPLE_ID=
